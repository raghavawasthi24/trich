NODE_ENV=development
PORT=4000

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-search

SUPPLIER_A_URL=http://localhost:4000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:4000/supplierB/hotels
SUPPLIER_TIMEOUT_MS=4500

AUTH_DISABLED=false
